# skillswapBE environment variables
# Copy this file to `.env` and fill in real values. Never commit the real `.env` (it is gitignored).

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/skillswap

# Secrets used to sign JWT tokens — use long random strings (different values!)
JWT_ACCESS_SECRET=replace-with-access-token-secret
JWT_REFRESH_SECRET=replace-with-refresh-token-secret

# Port for the hybrid HTTP + Socket.IO server
PORT=5000

# 'production' enables secure cookies (HTTPS-only)
NODE_ENV=development
